{
  "name": "kit",
  "private": true,
  "version": "0.2.0",
  "description": "Kit desktop toolbox for everyday workflows",
  "author": "Manon",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:base": "tsc && vite build",
    "build": "cross-env NODE_ENV=production npm run build:base",
    "build:analyze": "cross-env ANALYZE=1 npm run build && node scripts/build-optimizer.mjs",
    "build:cloudflare": "npm run build:base && cross-env NITRO_PRESET=cloudflare-pages nitro build",
    "build:vercel": "npm run build:base && cross-env NITRO_PRESET=vercel nitro build",
    "build:nitro": "npm run build:base && nitro build",
    "analyze": "cross-env ANALYZE=1 npm run build",
    "build:production": "npm run build && npm run optimize",
    "preview": "pnpm run build:base && wrangler dev",
    "optimize": "node scripts/build-optimizer.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "publish": "node scripts/updater.mjs",
    "changelog": "node scripts/changelog-generator.mjs",
    "changelog:generate": "node scripts/changelog-generator.mjs generate",
    "changelog:release": "node scripts/changelog-generator.mjs release-notes",
    "changelog:test": "node scripts/test-changelog.mjs",
    "release:patch": "npm version patch && npm run changelog:generate && git add CHANGELOG.md && git commit -m 'docs: update changelog' && git push --tags",
    "release:minor": "npm version minor && npm run changelog:generate && git add CHANGELOG.md && git commit -m 'docs: update changelog' && git push --tags",
    "release:major": "npm version major && npm run changelog:generate && git add CHANGELOG.md && git commit -m 'docs: update changelog' && git push --tags",
    "clean": "rm -rf dist node_modules/.vite",
    "ci:build:analyze": "cross-env ANALYZE=1 npm run build && node scripts/build-optimizer.mjs",
    "clean:all": "npm run clean && rm -rf node_modules",
    "ci:check-tools": "node scripts/check-tools.mjs",
    "prepare:icons": "node scripts/prepare-icons.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/prepare-icons.mjs && tauri build",
    "fix:mac": "echo '请使用: ./scripts/fix-mac-gatekeeper.sh <应用路径>' && echo '例如: ./scripts/fix-mac-gatekeeper.sh ~/Downloads/Kit.app'",
    "deploy": "pnpm run build:base && wrangler deploy"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.6",
    "@tanstack/react-query-devtools": "^5.102.6",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-virtual": "^3.14.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "gifuct-js": "^2.1.2",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.34.0",
    "mermaid": "^11.17.2",
    "motion": "^13.1.1",
    "nanoid": "^6.0.1",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vaul": "^1.1.2",
    "web-vitals": "^6.2.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@actions/github": "^9.1.1",
    "@tanstack/router-plugin": "^1.168.35",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "jsdom": "^30.0.1",
    "nitropack": "^2.13.4",
    "png-to-ico": "^3.0.2",
    "rollup-plugin-visualizer": "^7.1.1",
    "terser": "^5.51.0",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0",
    "wrangler": "^4.126.0"
  }
}
